# Flask
FLASK_ENV=production
SECRET_KEY=gere-uma-chave-segura-com-openssl-rand-hex-32

# Database
# Para SQLite (desenvolvimento):
DATABASE_URL=sqlite:///obito.db
# Para PostgreSQL (produção):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/obito_db

# Admin
ADMIN_PASSWORD=senha-forte-do-admin

# Upload
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Rate Limiting (opcional - Redis)
# REDIS_URL=redis://localhost:6379/0

# Logs
LOG_LEVEL=INFO